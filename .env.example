# Copia este fichero a .env y cambia la contraseña antes de levantar docker-compose.
DB_NAME=turnos
DB_PASSWORD=changeme

# Avisos por correo al equipo. Mientras MAIL_ENABLED sea false no sale ningún correo: el
# aviso se escribe en el log y la aplicación avisa de que no se ha enviado. Ese es el
# estado por defecto para que un entorno de pruebas no pueda escribir a la plantilla real.
#
# Para enviar de verdad con Gmail hace falta una "contraseña de aplicación", no la de tu
# cuenta: se crea desde la cuenta de Google, en Seguridad, con la verificación en dos pasos
# activada. Va aquí, en el .env, que no se sube al repositorio. Nunca en application.yml
# ni en el código.
MAIL_ENABLED=false
MAIL_FROM=tu-correo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=la-contrasena-de-aplicacion
